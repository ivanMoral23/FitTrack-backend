### ─────────────────────────────────────────
### PECHO
### ─────────────────────────────────────────
POST {{baseUrl}}/exercices/create
Content-Type: application/json
Authorization: Bearer {{token}}

[
  {
    "name": "Press de banca con barra",
    "difficulty": "medium",
    "muscle_group": "Pecho",
    "secondary_muscle_groups": ["Tríceps", "Hombro"],
    "equipment": ["barbell", "bench"],
    "recordType": "weight_reps",
    "mechanics": "compound",
    "movement_pattern": "horizontal_push",
    "instructions": [
      "Túmbate en el banco con los pies apoyados en el suelo.",
      "Agarra la barra con un agarre ligeramente más ancho que los hombros.",
      "Baja la barra de forma controlada hasta rozar el pecho.",
      "Empuja la barra hacia arriba extendiendo los codos completamente."
    ]
  },
  {
    "name": "Press de banca inclinado con barra",
    "difficulty": "medium",
    "muscle_group": "Pecho",
    "secondary_muscle_groups": ["Tríceps", "Hombro"],
    "equipment": ["barbell", "incline bench"],
    "recordType": "weight_reps",
    "mechanics": "compound",
    "movement_pattern": "horizontal_push",
    "instructions": [
      "Ajusta el banco a 30-45 grados.",
      "Agarra la barra con agarre ligeramente más ancho que los hombros.",
      "Baja la barra controladamente hacia la parte superior del pecho.",
      "Empuja hacia arriba y ligeramente hacia atrás."
    ]
  },
  {
    "name": "Press de banca declinado con barra",
    "difficulty": "medium",
    "muscle_group": "Pecho",
    "secondary_muscle_groups": ["Tríceps"],
    "equipment": ["barbell", "decline bench"],
    "recordType": "weight_reps",
    "mechanics": "compound",
    "movement_pattern": "horizontal_push",
    "instructions": [
      "Ajusta el banco en posición declinada.",
      "Agarra la barra y bájala controladamente hacia la parte inferior del pecho.",
      "Empuja hacia arriba hasta extender completamente los brazos."
    ]
  },
  {
    "name": "Press de banca con mancuernas",
    "difficulty": "medium",
    "muscle_group": "Pecho",
    "secondary_muscle_groups": ["Tríceps", "Hombro"],
    "equipment": ["dumbbells", "bench"],
    "recordType": "weight_reps",
    "mechanics": "compound",
    "movement_pattern": "horizontal_push",
    "instructions": [
      "Túmbate en el banco con una mancuerna en cada mano.",
      "Baja las mancuernas hasta el nivel del pecho con los codos a 45-75 grados.",
      "Empuja hacia arriba juntando ligeramente las mancuernas en la parte superior."
    ]
  },
  {
    "name": "Aperturas con mancuernas",
    "difficulty": "easy",
    "muscle_group": "Pecho",
    "secondary_muscle_groups": ["Hombro"],
    "equipment": ["dumbbells", "bench"],
    "recordType": "weight_reps",
    "mechanics": "isolation",
    "movement_pattern": "horizontal_push",
    "instructions": [
      "Túmbate en el banco con una mancuerna en cada mano, brazos extendidos sobre el pecho.",
      "Abre los brazos hacia los lados de forma arqueada hasta sentir el estiramiento en el pecho.",
      "Vuelve a la posición inicial contrayendo el pecho."
    ]
  },
  {
    "name": "Fondos en paralelas (pecho)",
    "difficulty": "hard",
    "muscle_group": "Pecho",
    "secondary_muscle_groups": ["Tríceps", "Hombro"],
    "equipment": ["parallel bars"],
    "recordType": "weight_reps",
    "mechanics": "compound",
    "movement_pattern": "horizontal_push",
    "instructions": [
      "Sujétate en las paralelas con el torso ligeramente inclinado hacia adelante.",
      "Baja el cuerpo doblando los codos hasta que los hombros queden a la altura de los codos.",
      "Empuja hacia arriba extendiendo los brazos completamente."
    ]
  },
  {
    "name": "Cruce de poleas",
    "difficulty": "easy",
    "muscle_group": "Pecho",
    "secondary_muscle_groups": [],
    "equipment": ["cable machine"],
    "recordType": "weight_reps",
    "mechanics": "isolation",
    "movement_pattern": "horizontal_push",
    "instructions": [
      "Colócate en el centro de la máquina de poleas con los cables a la altura de los hombros.",
      "Con los brazos ligeramente flexionados, junta las manos frente al pecho.",
      "Vuelve a la posición inicial de forma controlada."
    ]
  },
  {
    "name": "Flexiones",
    "difficulty": "easy",
    "muscle_group": "Pecho",
    "secondary_muscle_groups": ["Tríceps", "Hombro"],
    "equipment": [],
    "recordType": "weight_reps",
    "mechanics": "compound",
    "movement_pattern": "horizontal_push",
    "instructions": [
      "Colócate en posición de plancha con las manos a la anchura de los hombros.",
      "Baja el cuerpo hasta que el pecho casi toque el suelo.",
      "Empuja hacia arriba extendiendo los brazos."
    ]
  }
]
