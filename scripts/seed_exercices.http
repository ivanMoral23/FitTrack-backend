    "recordType": "weight_reps",
    "mechanics": "isolation",
    "movement_pattern": "isolation_extension",
    "instructions": [
      "Sostén una mancuerna con ambas manos sobre la cabeza con los brazos extendidos.",
      "Dobla los codos bajando la mancuerna detrás de la cabeza.",
      "Extiende los brazos para volver a la posición inicial."
    ]
  },
  {
    "name": "Patada de tríceps con mancuerna",
    "difficulty": "easy",
    "muscle_group": "Tríceps",
    "secondary_muscle_groups": [],
    "equipment": ["dumbbell", "bench"],
    "recordType": "weight_reps",
    "mechanics": "isolation",
    "movement_pattern": "isolation_extension",
    "instructions": [
      "Apoya una rodilla y una mano en el banco, inclínate hacia adelante.",
      "Sostén la mancuerna con el brazo libre, codo doblado a 90 grados.",
      "Extiende el brazo hacia atrás hasta que quede paralelo al suelo."
    ]
  },
  {
    "name": "Fondos en banco",
    "difficulty": "easy",
    "muscle_group": "Tríceps",
    "secondary_muscle_groups": ["Hombro", "Pecho"],
