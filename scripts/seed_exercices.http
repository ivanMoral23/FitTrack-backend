### PIERNA
### ─────────────────────────────────────────
POST {{baseUrl}}/exercices/create
Content-Type: application/json
Authorization: Bearer {{token}}

[
  {
    "name": "Sentadilla con barra",
    "difficulty": "hard",
    "muscle_group": "Pierna",
    "secondary_muscle_groups": ["Glúteos", "Espalda"],
    "equipment": ["barbell", "squat rack"],
    "recordType": "weight_reps",
    "mechanics": "compound",
    "movement_pattern": "squat",
    "instructions": [
      "Coloca la barra en la parte alta de la espalda.",
      "Pies a la anchura de los hombros, punta de los pies ligeramente hacia afuera.",
      "Baja doblando rodillas y caderas hasta que los muslos queden paralelos al suelo.",
      "Sube extendiendo rodillas y caderas."
    ]
  },
  {
    "name": "Sentadilla frontal",
    "difficulty": "hard",
